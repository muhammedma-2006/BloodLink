# BloodLink Frontend Environment Configuration

# Backend API URL
# - For local development: leave unset (defaults to '/api' which proxies to http://localhost:5000 via vite.config.js)
#   or set explicitly: VITE_API_URL=http://localhost:5000
# - For production deployment on Vercel: set to your deployed backend project URL (e.g., https://your-backend.vercel.app)
VITE_API_URL=https://blood-link-czmx.vercel.app/
