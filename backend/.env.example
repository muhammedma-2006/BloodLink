# BloodLink Backend Environment Configuration

# Server Port (used for local development)
PORT=5000

# MongoDB Atlas Connection URI
# Local fallback uses in-memory MongoDB automatically if unreachable
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bloodlink?retryWrites=true&w=majority

# JWT Signing Secret (required in production)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Token Lifetime
JWT_EXPIRES_IN=7d

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (your deployed Vercel frontend URL or custom domain)
# Multiple origins can be separated by commas (e.g. https://bloodlink.vercel.app,https://yourdomain.org)
FRONTEND_URL=https://your-frontend-project.vercel.app

# Optional: Automatic Initial Administrator Setup
# If configured and 0 admins exist in the DB, this admin will be initialized automatically.
# Alternatively, use the Web Setup Wizard at /setup-admin or run: npm run setup:admin
# ADMIN_EMAIL=admin@yourorganization.org
# ADMIN_PASSWORD=YourSecurePassword123!
# ADMIN_NAME=Platform Administrator
